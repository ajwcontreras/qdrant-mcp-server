{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfcode-codebase-mortgage-rag",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "cfcode-mortgage-rag-artifacts"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfcode-mortgage-rag",
      "database_id": "fc453a96-2424-4bd4-8d74-8213ddbec3ce"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "cfcode-mortgage-rag"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INDEXING_SHARD_V2",
        "class_name": "IndexingShardV2"
      },
      {
        "name": "HYDE_SHARD_V2",
        "class_name": "HydeShardV2"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "IndexingShardV2",
        "HydeShardV2"
      ]
    }
  ],
  "vars": {
    "SHARD_COUNT": "4",
    "BATCH_SIZE": "100"
  },
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "WORK_QUEUE",
        "queue": "cfcode-mortgage-rag-work"
      }
    ]
  }
}